+++ b/flow-go/internal/engine/console_browser.go
@@ -0,0 +1,99 @@
+package engine
+
+import (
+	"context"
+	"fmt"
+	"log"
+	"net/url"
+	"regexp"
+	"time"
+
+	"github.com/kodelyx/flow-go/flow-go/internal/cdp"
+	"github.com/kodelyx/flow-go/flow-go/internal/cookiejar"
+)
+
+// Only the actionless bridge probe is permitted here. Respect the public
+// client's protection and return before Bootstrap can reach token acquisition.
+func waitConsoleCaptcha(ctx context.Context, probe func(context.Context) (*cdp.FlowCaptchaResult, error)) error {
+	for {
+		result, err := probe(ctx)
+		if err == nil && result != nil && result.Error == "BROWSER_VERIFICATION_PROTECTED" {
+			return fmt.Errorf("BROWSER_VERIFICATION_PROTECTED: official public client blocks external execution; no token or generation requested")
+		}
+		if err == nil && result != nil && result.Available {
+			return nil
+		}
+		select {
+		case <-ctx.Done():
+			return fmt.Errorf("BROWSER_PAGE_NOT_READY: login or manual verification may be required")
+		case <-time.After(500 * time.Millisecond):
+		}
+	}
+}
+
+func (e *Engine) requireConsoleBrowser(ctx context.Context) error {
+	if e.opts.CookieFile == "" || e.bridge == nil {
+		return fmt.Errorf("BROWSER_ACCOUNT_MISSING: an explicit account is required")
+	}
+	jar, err := cookiejar.LoadFile(e.opts.CookieFile)
+	if err != nil {
+		return fmt.Errorf("BROWSER_ACCOUNT_MISSING: account file unavailable")
+	}
+	wait, cancel := context.WithTimeout(ctx, 35*time.Second)
+	defer cancel()
+	client, err := e.bridge.PinAccount(wait, cookiejar.AccountKey(jar))
+	if err != nil {
+		return err
+	}
+	supported := false
+	for _, op := range client.Surface().Advertised {
+		if op == "flow.consoleScope" {
+			supported = true
+		}
+	}
+	if !supported {
+		return fmt.Errorf("BROWSER_EXTENSION_UPDATE_REQUIRED: reload Flow Bridge")
+	}
+	var scope struct {
+		Owned bool `json:"owned"`
+	}
+	if err = client.Call(wait, "flow.consoleScope", map[string]any{}, &scope); err != nil || !scope.Owned {
+		return fmt.Errorf("BROWSER_OWNED_TAB_MISSING")
+	}
+	synced, err := e.bridge.SyncCookies(wait, client)
+	if err != nil || cookiejar.AccountKey(synced) != cookiejar.AccountKey(jar) {
+		return fmt.Errorf("BROWSER_ACCOUNT_CHANGED: selected browser identity changed")
+	}
+	bundle, err := cookiejar.LoadBundleFile(e.opts.CookieFile)
+	if err != nil || bundle.ProjectID == "" {
+		return fmt.Errorf("BROWSER_PROJECT_MISSING")
+	}
+	if _, err = client.Attach(wait, 0); err != nil {
+		return fmt.Errorf("BROWSER_PAGE_NOT_READY")
+	}
+	if err = client.FlowNavigate(wait, "https://flow.google.com/project/"+url.PathEscape(bundle.ProjectID), ""); err != nil {
+		return fmt.Errorf("BROWSER_PAGE_NOT_READY")
+	}
+	if err = waitConsoleCaptcha(wait, func(ctx context.Context) (*cdp.FlowCaptchaResult, error) {
+		return client.FlowCaptcha(ctx, "", "")
+	}); err != nil {
+		return err
+	}
+	synced, err = e.bridge.SyncCookies(wait, client)
+	if err != nil || cookiejar.AccountKey(synced) != cookiejar.AccountKey(jar) {
+		return fmt.Errorf("BROWSER_ACCOUNT_CHANGED")
+	}
+	var page struct {
+		BuildLabel string `json:"buildLabel"`
+	}
+	if err = client.Call(wait, "flow.at", map[string]any{}, &page); err != nil ||
+		!regexp.MustCompile(`^boq_labs-ai-sandbox-frontend_[A-Za-z0-9._-]+$`).MatchString(page.BuildLabel) {
+		return fmt.Errorf("BROWSER_EXTENSION_UPDATE_REQUIRED: live page build unavailable")
+	}
+	e.mu.Lock()
+	e.consoleBuildLabel = page.BuildLabel
+	e.mu.Unlock()
+	log.Printf("browser-required: using live page build %s", page.BuildLabel)
+	log.Printf("browser-required: selected account extension pinned; HTTP captcha fallback disabled")
+	return nil
+}
