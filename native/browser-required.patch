+package engine
+
+import (
+	"context"
+	"strings"
+	"testing"
+	"time"
+
+	"github.com/kodelyx/flow-go/flow-go/internal/cdp"
+)
+
+func TestConsoleCaptchaStopsAtOfficialProtection(t *testing.T) {
+	ctx, cancel := context.WithTimeout(context.Background(), time.Second)
+	defer cancel()
+	calls := 0
+	err := waitConsoleCaptcha(ctx, func(context.Context) (*cdp.FlowCaptchaResult, error) {
+		calls++
+		// Protection takes priority even if an older peer also reports available.
+		return &cdp.FlowCaptchaResult{Available: true, Error: "BROWSER_VERIFICATION_PROTECTED"}, nil
+	})
+	if err == nil || !strings.Contains(err.Error(), "BROWSER_VERIFICATION_PROTECTED") {
+		t.Fatalf("expected explicit protection failure, got %v", err)
+	}
+	if calls != 1 {
+		t.Fatalf("protected page must not be retried, got %d probes", calls)
+	}
+}
+
+func TestConsoleCaptchaUnavailableDoesNotPassBootstrap(t *testing.T) {
+	ctx, cancel := context.WithCancel(context.Background())
+	cancel()
+	err := waitConsoleCaptcha(ctx, func(context.Context) (*cdp.FlowCaptchaResult, error) {
+		return &cdp.FlowCaptchaResult{}, nil
+	})
+	if err == nil || !strings.Contains(err.Error(), "BROWSER_PAGE_NOT_READY") {
+		t.Fatalf("expected unavailable failure, got %v", err)
+	}
+}
+
+func TestConsoleCaptchaLoadedUnprotectedProbe(t *testing.T) {
+	err := waitConsoleCaptcha(context.Background(), func(context.Context) (*cdp.FlowCaptchaResult, error) {
+		return &cdp.FlowCaptchaResult{Available: true}, nil
+	})
+	if err != nil {
+		t.Fatal(err)
+	}
+}
