@@ -0,0 +1,81 @@
+package bridge
+
+import (
+	"context"
+	"github.com/gorilla/websocket"
+	"github.com/kodelyx/flow-go/flow-go/internal/cdp"
+	"github.com/kodelyx/flow-go/flow-go/internal/cookiejar"
+	"net/http"
+	"net/http/httptest"
+	"strings"
+	"testing"
+	"time"
+)
+
+func consolePeer(t *testing.T, value string) *cdp.Client {
+	t.Helper()
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		socket, err := (&websocket.Upgrader{}).Upgrade(w, r, nil)
+		if err != nil {
+			return
+		}
+		defer socket.Close()
+		for {
+			var request struct {
+				ID string `json:"id"`
+				Op string `json:"op"`
+			}
+			if socket.ReadJSON(&request) != nil {
+				return
+			}
+			var result any = map[string]any{"ok": true, "version": "1.0.4", "ops": []string{"flow.captcha", "cookies.list"}}
+			if request.Op == "cookies.list" {
+				result = []cookiejar.Cookie{{Name: "SAPISID", Value: value, Domain: ".google.com", Path: "/"}}
+			}
+			if socket.WriteJSON(map[string]any{"id": request.ID, "result": result}) != nil {
+				return
+			}
+		}
+	}))
+	t.Cleanup(server.Close)
+	client, err := cdp.Dial(context.Background(), "ws"+strings.TrimPrefix(server.URL, "http"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(func() { client.Close() })
+	return client
+}
+func TestConsolePinsExactAccountDespiteLaterProfileConnection(t *testing.T) {
+	b := newTestBridge(t)
+	first := consolePeer(t, "first")
+	other := consolePeer(t, "other")
+	b.add(first)
+	b.add(other)
+	expected := cookiejar.AccountKey(cookiejar.FromCookies([]cookiejar.Cookie{{Name: "SAPISID", Value: "first"}}, "test"))
+	ctx, cancel := context.WithTimeout(context.Background(), time.Second)
+	defer cancel()
+	selected, err := b.PinAccount(ctx, expected)
+	if err != nil || selected != first {
+		t.Fatalf("wrong account: %v", err)
+	}
+	b.add(other)
+	if b.Current() != first {
+		t.Fatal("a later profile replaced the requested account")
+	}
+	first.Close()
+	if b.Connected() {
+		t.Fatal("disconnect must not fall back to another account")
+	}
+}
+func TestConsoleRejectsMissingSelectedAccount(t *testing.T) {
+	b := newTestBridge(t)
+	b.add(consolePeer(t, "other"))
+	ctx, cancel := context.WithTimeout(context.Background(), 30*time.Millisecond)
+	defer cancel()
+	if _, err := b.PinAccount(ctx, "missing"); err == nil {
+		t.Fatal("mismatched browser accepted")
+	}
+	if b.Current() != nil {
+		t.Fatal("wrong profile remains selected")
+	}
+}
