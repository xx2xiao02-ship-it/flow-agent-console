+package recaptcha
+
+import (
+	"context"
+	"github.com/kodelyx/flow-go/flow-go/internal/cdp"
+	"testing"
+)
+
+func TestConsoleBrowserNeverFallsBackToHTTPOrEmpty(t *testing.T) {
+	p := Build("browser", nil, nil, nil, func() *cdp.Client { return nil }, "")
+	if p.Name() != "chain(flow.captcha)" {
+		t.Fatalf("unexpected providers: %s", p.Name())
+	}
+	token, err := p.Token(context.Background(), ActionImage)
+	if err == nil || token != "" {
+		t.Fatal("a missing browser must fail before submission")
+	}
+}
