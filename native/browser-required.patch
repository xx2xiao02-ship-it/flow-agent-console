@@ -0,0 +1,50 @@
+package cli
+
+import (
+	"context"
+	"encoding/json"
+	"flag"
+	"fmt"
+	"os"
+	"time"
+)
+
+// runBrowserCheck follows the generation bootstrap and only probes whether the
+// page has its own verification client. No token mint or generation is invoked.
+func runBrowserCheck(args []string) int {
+	fs := flag.NewFlagSet("browser-check", flag.ContinueOnError)
+	var common commonFlags
+	common.bind(fs)
+	if err := fs.Parse(args); err != nil {
+		return 2
+	}
+	common.captcha = "browser"
+	a, err := common.build()
+	if err != nil {
+		return fail(err)
+	}
+	defer a.Close()
+	ctx, cancel := context.WithTimeout(context.Background(), 90*time.Second)
+	defer cancel()
+	attachBridgeWithin(ctx, a, bridgeAttachWindow, true)
+	if err = a.Engine.Bootstrap(ctx); err != nil {
+		return fail(err)
+	}
+	// Use the same account-bound current connection as the strict provider.
+	client := a.Bridge.Current()
+	if client == nil || !client.Connected() {
+		return fail(fmt.Errorf("BROWSER_ACCOUNT_NOT_CONNECTED"))
+	}
+	probe, err := client.FlowCaptcha(ctx, "", "")
+	if err != nil {
+		return fail(fmt.Errorf("BROWSER_PAGE_NOT_READY"))
+	}
+	if probe.Error == "BROWSER_VERIFICATION_PROTECTED" {
+		return fail(fmt.Errorf("BROWSER_VERIFICATION_PROTECTED: official public client blocks external execution; no token or generation requested"))
+	}
+	if !probe.Available {
+		return fail(fmt.Errorf("BROWSER_PAGE_NOT_READY: verification client absent; no generation submitted"))
+	}
+	json.NewEncoder(os.Stdout).Encode(map[string]any{"browser_connected": true, "account_id": a.Engine.AccountID(), "captcha_provider": "flow.captcha", "verification_client_loaded": true, "token_minted": false, "generation_submitted": false})
+	return 0
+}
