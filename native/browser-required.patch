diff --git a/flow-go/internal/bridge/console_browser.go b/flow-go/internal/bridge/console_browser.go
new file mode 100644
index 0000000..7904889
--- /dev/null
+++ b/flow-go/internal/bridge/console_browser.go
@@ -0,0 +1,61 @@
+package bridge
+
+import (
+	"context"
+	"encoding/json"
+	"fmt"
+	"sort"
+	"time"
+
+	"github.com/kodelyx/flow-go/flow-go/internal/cdp"
+	"github.com/kodelyx/flow-go/flow-go/internal/cookiejar"
+)
+
+// PinAccount binds browser operations to the exact cookie identity requested by
+// the caller. Later connections and disconnects must never select another user.
+func (b *Bridge) PinAccount(ctx context.Context, key string) (*cdp.Client, error) {
+	if key == "" {
+		return nil, fmt.Errorf("BROWSER_ACCOUNT_MISSING")
+	}
+	b.mu.Lock()
+	b.consolePinned = true
+	b.consoleClient = nil
+	b.mu.Unlock()
+	for {
+		clients := b.Clients()
+		addresses := make([]string, 0, len(clients))
+		for address := range clients {
+			addresses = append(addresses, address)
+		}
+		sort.Strings(addresses)
+		for _, address := range addresses {
+			client := clients[address]
+			if !client.ProbeSurface().FlowOperations {
+				continue
+			}
+			readCtx, cancel := context.WithTimeout(ctx, 3*time.Second)
+			cookies, err := client.ListCookies(readCtx, map[string]any{"domain": "google.com"})
+			cancel()
+			if err != nil {
+				continue
+			}
+			raw, _ := json.Marshal(cookies)
+			var converted []cookiejar.Cookie
+			if json.Unmarshal(raw, &converted) != nil {
+				continue
+			}
+			if cookiejar.AccountKey(cookiejar.FromCookies(converted, "browser-check")) != key {
+				continue
+			}
+			b.mu.Lock()
+			b.consoleClient = client
+			b.mu.Unlock()
+			return client, nil
+		}
+		select {
+		case <-ctx.Done():
+			return nil, fmt.Errorf("BROWSER_ACCOUNT_NOT_CONNECTED: selected account browser is unavailable")
+		case <-time.After(250 * time.Millisecond):
+		}
+	}
+}
