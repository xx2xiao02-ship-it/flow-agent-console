@@ -0,0 +1,92 @@
+package batchexecute
+
+import (
+	"context"
+	"errors"
+	"fmt"
+	"net/http"
+	"net/http/httptest"
+	"strings"
+	"testing"
+)
+
+func TestConsoleNeverReplaysEmptyGeneration(t *testing.T) {
+	t.Setenv("FLOW_NO_SUBMISSION_REPLAY", "1")
+	server, requests := generationServer(t, RPCIDGenerate, emptyPayload, assetPayload())
+	pointAt(t, server)
+	minted := 0
+	_, err := testClient(t).GenerateMedia(context.Background(), imageRequest("token-0"), CallOptions{RefreshCaptcha: refresher(&minted)})
+	var empty *EmptyMediaError
+	if !errors.As(err, &empty) || empty.Frames != 1 {
+		t.Fatalf("lost frame count: %v", err)
+	}
+	if len(*requests) != 1 || minted != 0 {
+		t.Fatalf("sent=%d refreshed=%d", len(*requests), minted)
+	}
+}
+
+func TestConsoleNoReplayStillReportsFirstResponseRefusal(t *testing.T) {
+	t.Setenv("FLOW_NO_SUBMISSION_REPLAY", "1")
+	for _, reason := range []string{ReasonUnusualActivity, "PUBLIC_ERROR_PERMISSION_DENIED"} {
+		t.Run(reason, func(t *testing.T) {
+			requests := 0
+			server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+				requests++
+				fmt.Fprint(w, strings.ReplaceAll(liveRefusal, ReasonUnusualActivity, reason))
+			}))
+			t.Cleanup(server.Close)
+			pointAt(t, server)
+			minted, noted := 0, 0
+			_, err := testClient(t).GenerateMedia(context.Background(), imageRequest("token-0"), CallOptions{
+				RefreshCaptcha: refresher(&minted), NoteUnusualActivity: func() { noted++ },
+			})
+			var rejected *RejectedError
+			if !errors.As(err, &rejected) || rejected.Reason != reason || rejected.Frames != 1 || requests != 1 || minted != 0 {
+				t.Fatalf("err=%v sent=%d minted=%d", err, requests, minted)
+			}
+			if IsUnusualActivity(reason) && noted != 1 {
+				t.Fatal("assessment refusal not recorded")
+			}
+		})
+	}
+}
+
+func TestLivePageBuildOverridesStaleCallBuild(t *testing.T) {
+	c := testClient(t)
+	if c.buildLabelFor(CallOptions{BuildLabel: "legacy"}) != "legacy" {
+		t.Fatal("legacy CLI changed")
+	}
+	c.SetPageBuildLabel("boq_labs-ai-sandbox-frontend_20261016.00_p1")
+	if c.buildLabelFor(CallOptions{BuildLabel: "legacy"}) != "boq_labs-ai-sandbox-frontend_20261016.00_p1" {
+		t.Fatal("live page build ignored")
+	}
+}
+func TestConsoleNeverReplaysAfterPriming(t *testing.T) {
+	t.Setenv("FLOW_NO_SUBMISSION_REPLAY", "1")
+	server, requests := primingServer(t)
+	pointAt(t, server)
+	_, err := testClient(t).Generate(context.Background(), imageRequest("token-0"), CallOptions{})
+	if err == nil || !strings.Contains(err.Error(), "GENERATION_REPLAY_BLOCKED") || len(*requests) != 1 {
+		t.Fatalf("sent=%d err=%v", len(*requests), err)
+	}
+}
+func TestReadOnlyBrowserCheckBlocksEveryGenerationSend(t *testing.T) {
+	t.Setenv("FLOW_BLOCK_GENERATION", "1")
+	server, requests := generationServer(t, RPCIDGenerate, assetPayload())
+	pointAt(t, server)
+	_, err := testClient(t).GenerateMedia(context.Background(), imageRequest("token-0"), CallOptions{})
+	if err == nil || !strings.Contains(err.Error(), "GENERATION_BLOCKED") || len(*requests) != 0 {
+		t.Fatalf("sent=%d err=%v", len(*requests), err)
+	}
+}
+func TestConsolePreservesSuccessfulBelugaPayload(t *testing.T) {
+	t.Setenv("FLOW_NO_SUBMISSION_REPLAY", "1")
+	server, requests := generationServer(t, RPCIDGenerate, assetPayload())
+	pointAt(t, server)
+	req := imageRequest("token-0")
+	req.Model = "BELUGA"
+	media, err := testClient(t).GenerateMedia(context.Background(), req, CallOptions{})
+	if err != nil || len(media) != 1 || len(*requests) != 1 || !strings.Contains((*requests)[0], "BELUGA") {
+		t.Fatalf("media=%d sent=%d err=%v", len(media), len(*requests), err)
+	}
+}
